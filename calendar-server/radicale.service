# The Calendar Server. Installed into /etc/systemd/system on every boot of the
# `calendar-server` qube by /rw/config/rc.local (see install.sh), because the
# root filesystem of a Qubes AppVM does not persist.
[Unit]
Description=Calendar Server (Radicale)
After=network-online.target
Wants=network-online.target

[Service]
User=user
# SELinux forbids systemd to execute anything under /home (user_home_t),
# including the venv's python symlink. So execute /usr/bin/python3 (bin_t)
# and pass the venv's python path as argv[0] ("@"): Python finds the venv
# from argv[0] and loads Radicale from it.
ExecStart=@/usr/bin/python3 /home/user/radicale/venv/bin/python -m radicale --config /home/user/radicale/radicale.conf
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/user/radicale/collections
PrivateTmp=true

[Install]
WantedBy=multi-user.target
